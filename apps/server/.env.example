# PostgreSQL connection string (Neon / Supabase / local)
# Для Neon: обязательно sslmode=require и connect_timeout
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&connect_timeout=30"

# JWT secret (минимум 32 символа)
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-64-char-hex-string"

# Время жизни access-токена ('7d', '1h', '3600s')
JWT_EXPIRES_IN="7d"

# Порт API
PORT=3000

# Origin клиента для CORS
CLIENT_ORIGIN="http://localhost:5173"